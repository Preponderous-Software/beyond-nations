# OS noise
.DS_Store
Thumbs.db

# Note: *.sln and *.csproj are deliberately NOT ignored.
#
# Unity regenerated its own project files, so the Unity .gitignore excluded
# them. That ignore silently swallowed BeyondNations.sln and both .csproj files
# across four merged pull requests, leaving a fresh clone with nothing to build.
# The solution and its projects are source now. See #215.
