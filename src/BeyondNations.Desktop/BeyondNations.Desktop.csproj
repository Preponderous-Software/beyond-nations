<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>beyondnations.desktop</RootNamespace>
    <AssemblyName>BeyondNations.Desktop</AssemblyName>
    <!--
      The renderer hands vertex and instance data to the driver as raw pointers.
      Copying it through a managed intermediate every frame would be exactly the
      per-frame allocation #218 rules out.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FontStashSharp" Version="1.3.10" />
    <!--
      The user interface (#221). Dear ImGui is immediate mode, as the OnGUI code
      it replaces was, so the screens map across shape for shape.
      Silk.NET.OpenGL.Extensions.ImGui supplies the GL backend and the input
      plumbing, so neither has to be written here.
    -->
    <!--
      Pinned to 1.90.8.1 deliberately. The native libcimgui.so shipped with
      1.91.6.1 is built against GLIBC 2.38, so the game fails at startup with
      "Unable to load shared library cimgui" on any distribution older than
      that, Ubuntu 20.04 and 22.04 included. 1.90.8.1 has no such requirement,
      and is the version Silk.NET.OpenGL.Extensions.ImGui 2.23.0 resolves on
      its own. See #221.
    -->
    <PackageReference Include="ImGui.NET" Version="1.90.8.1" />
    <PackageReference Include="Silk.NET.OpenGL.Extensions.ImGui" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bundled font travels with the build; the game reads it at startup
         to pack its glyph atlas. Its licence sits beside it. See #222. -->
    <None Include="assets/fonts/DejaVuSans.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets/fonts/LICENSE-DejaVu.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Usage reporting defaults (enabled, endpoint, key), read at startup
         from beside the executable. See telemetry/UsageReporting.cs. -->
    <None Include="usage-reporting.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BeyondNations.Core/BeyondNations.Core.csproj" />
  </ItemGroup>

  <!--
    Strata, the shared native engine (#274). One native library per platform,
    taken from a pinned Strata release and checked against its SHA-256, then
    shipped under runtimes/<rid>/native/ beside cimgui and glfw. BN's build
    never compiles C++.

    To test against a local Strata build instead, pass
    /p:StrataNativeDir=/path/to/strata/build (the directory that holds
    libstrata.so or strata.dll); nothing is downloaded then.

    A download that fails (no network) is a warning, not an error, so the
    solution still builds and the tests that do not load the library still
    run. The game itself does not: Strata is its only world renderer (#297),
    so it needs libstrata.so or strata.dll to start.
  -->
  <PropertyGroup>
    <StrataVersion>0.6.0</StrataVersion>
    <StrataReleaseUrl>https://github.com/Preponderous-Software/strata/releases/download/v$(StrataVersion)</StrataReleaseUrl>
    <StrataLinuxSha256>3815068f90afa67b42177359a7ea918a5de321d7f7bad8706fa5275c4906af2a</StrataLinuxSha256>
    <StrataWindowsSha256>93236e25bb38f422d2033d9d19ab9d181515078e0d6b63addbb1ec2a9d095c13</StrataWindowsSha256>
    <StrataCacheDir>$(BaseIntermediateOutputPath)strata/$(StrataVersion)/</StrataCacheDir>
  </PropertyGroup>

  <Target Name="IncludeStrataNative" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <_StrataLinux>$(StrataCacheDir)linux-x64/libstrata.so</_StrataLinux>
      <_StrataWindows>$(StrataCacheDir)win-x64/strata.dll</_StrataWindows>
    </PropertyGroup>

    <DownloadFile Condition="'$(StrataNativeDir)' == '' And !Exists('$(_StrataLinux)')"
                  SourceUrl="$(StrataReleaseUrl)/libstrata-$(StrataVersion)-linux-x64.so"
                  DestinationFolder="$(StrataCacheDir)linux-x64" DestinationFileName="libstrata.so"
                  ContinueOnError="WarnAndContinue" />
    <DownloadFile Condition="'$(StrataNativeDir)' == '' And !Exists('$(_StrataWindows)')"
                  SourceUrl="$(StrataReleaseUrl)/strata-$(StrataVersion)-win-x64.dll"
                  DestinationFolder="$(StrataCacheDir)win-x64" DestinationFileName="strata.dll"
                  ContinueOnError="WarnAndContinue" />

    <GetFileHash Condition="'$(StrataNativeDir)' == '' And Exists('$(_StrataLinux)')" Files="$(_StrataLinux)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_StrataLinuxHash" />
    </GetFileHash>
    <GetFileHash Condition="'$(StrataNativeDir)' == '' And Exists('$(_StrataWindows)')" Files="$(_StrataWindows)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_StrataWindowsHash" />
    </GetFileHash>
    <Delete Condition="'$(_StrataLinuxHash)' != '' And '$(_StrataLinuxHash)' != '$(StrataLinuxSha256)'" Files="$(_StrataLinux)" />
    <Error Condition="'$(_StrataLinuxHash)' != '' And '$(_StrataLinuxHash)' != '$(StrataLinuxSha256)'"
           Text="libstrata.so for Strata $(StrataVersion) has SHA-256 $(_StrataLinuxHash), expected $(StrataLinuxSha256). The download was deleted." />
    <Delete Condition="'$(_StrataWindowsHash)' != '' And '$(_StrataWindowsHash)' != '$(StrataWindowsSha256)'" Files="$(_StrataWindows)" />
    <Error Condition="'$(_StrataWindowsHash)' != '' And '$(_StrataWindowsHash)' != '$(StrataWindowsSha256)'"
           Text="strata.dll for Strata $(StrataVersion) has SHA-256 $(_StrataWindowsHash), expected $(StrataWindowsSha256). The download was deleted." />

    <ItemGroup Condition="'$(StrataNativeDir)' == ''">
      <None Include="$(_StrataLinux)" Condition="Exists('$(_StrataLinux)')" Link="runtimes/linux-x64/native/libstrata.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="$(_StrataWindows)" Condition="Exists('$(_StrataWindows)')" Link="runtimes/win-x64/native/strata.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup Condition="'$(StrataNativeDir)' != ''">
      <None Include="$(StrataNativeDir)/libstrata.so" Condition="Exists('$(StrataNativeDir)/libstrata.so')" Link="runtimes/linux-x64/native/libstrata.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="$(StrataNativeDir)/strata.dll" Condition="Exists('$(StrataNativeDir)/strata.dll')" Link="runtimes/win-x64/native/strata.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
