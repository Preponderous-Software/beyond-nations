<Project>

  <!--
    Strata, the engine the world is drawn with, linked into dotnet.native.wasm.

    The commit of a Strata release is pinned here (v0.4.0, the release the
    desktop pins too): the source tarball for that commit is checked against
    its SHA-256 and built by native/build-strata.sh with the Emscripten the
    wasm-tools workload links with. The release's own wasm32-emscripten
    archive is not used: Strata's CI builds it with a much newer emsdk
    (6.0.11) and merges SDL3 into it, and those objects do not link with the
    workload's emsdk 3.1.34. The result is cached under obj/ and linked as
    strata.a, whose file name is what [DllImport("strata")] resolves to.

    bnweb.a is native/bnweb_gl.c: it makes the page's WebGL 2 context known
    to Emscripten, which STRATA_SURFACE_HOST_CONTEXT requires.

    Building needs CMake 3.24 or newer: on PATH, or STRATA_CMAKE=/path/to/cmake.
    /p:StrataWebArchive=/path/to/strata.a links a Strata built elsewhere
    (it must be built with the same Emscripten and with wasm exceptions).
  -->

  <PropertyGroup>
    <StrataCommit>2e03be8e78ef23a8449bdeaa25f279dcf9700a7f</StrataCommit>
    <StrataSourceSha256>cbfd092504aa8a44ee1ad73d1b1fd91b4cc09a0e0cd2858bc86814d0e8754617</StrataSourceSha256>
    <StrataWebDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)strata-web/$(StrataCommit)/</StrataWebDir>
    <StrataWebArchive Condition="'$(StrataWebArchive)' == ''">$(StrataWebDir)strata.a</StrataWebArchive>
    <BnWebArchive>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)bnweb/bnweb.a</BnWebArchive>
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2</EmccExtraLDFlags>
  </PropertyGroup>

  <ItemGroup>
    <NativeFileReference Include="$(StrataWebArchive)" />
    <NativeFileReference Include="$(BnWebArchive)" />
  </ItemGroup>

  <Target Name="BuildStrataForWasm"
          BeforeTargets="_PrepareForWasmBuildNative"
          DependsOnTargets="_SetupEmscripten"
          Condition="!Exists('$(StrataWebArchive)')">
    <ItemGroup>
      <_StrataEnv Include="BN_EMSCRIPTEN_SDK=$(EmscriptenSdkToolsPath)" />
      <_StrataEnv Include="BN_EMSCRIPTEN_NODE=$(EmscriptenNodeToolsPath)bin/node" />
      <_StrataEnv Include="BN_EMSCRIPTEN_CACHE=$(EmscriptenCacheSdkCacheDir)" />
    </ItemGroup>
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)build-strata.sh&quot; $(StrataCommit) $(StrataSourceSha256) &quot;$(StrataWebDir)&quot;"
          EnvironmentVariables="@(_StrataEnv)" />
  </Target>

  <Target Name="BuildBnWebForWasm"
          BeforeTargets="_PrepareForWasmBuildNative"
          DependsOnTargets="_SetupEmscripten"
          Inputs="$(MSBuildThisFileDirectory)bnweb_gl.c"
          Outputs="$(BnWebArchive)">
    <ItemGroup>
      <_BnWebEnv Include="@(EmscriptenEnvVars)" />
      <_BnWebEnv Include="EM_CACHE=$(EmscriptenCacheSdkCacheDir)" />
      <_BnWebEnv Include="EM_FROZEN_CACHE=True" />
    </ItemGroup>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(BnWebArchive)'))" />
    <Exec Command="&quot;$(EmscriptenUpstreamEmscriptenPath)emcc&quot; -c -O2 &quot;$(MSBuildThisFileDirectory)bnweb_gl.c&quot; -o &quot;$(BnWebArchive).o&quot;"
          EnvironmentVariables="@(_BnWebEnv)" />
    <Delete Files="$(BnWebArchive)" />
    <Exec Command="&quot;$(EmscriptenUpstreamEmscriptenPath)emar&quot; rcs &quot;$(BnWebArchive)&quot; &quot;$(BnWebArchive).o&quot;"
          EnvironmentVariables="@(_BnWebEnv)" />
  </Target>

</Project>
