<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The winter seed sweep (README.md): runs headless worlds through a winter
    on many seeds and reports winter deaths, spring deaths, food per member
    and where the food went. It measured #495, #497 and #499 and is the
    yardstick for winter tuning (#504). It references Core and nothing else.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>beyondnations.wintersweep</RootNamespace>
    <AssemblyName>BeyondNations.WinterSweep</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BeyondNations.Core/BeyondNations.Core.csproj" />
  </ItemGroup>

</Project>
