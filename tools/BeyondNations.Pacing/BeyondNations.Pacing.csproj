<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The pacing harness (docs/PACING.md): a scripted player drives the Core
    simulation with no window across several seeds and records how long each
    objective takes. It references Core and nothing else; neither the game
    nor Core references it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>beyondnations.pacing</RootNamespace>
    <AssemblyName>BeyondNations.Pacing</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BeyondNations.Core/BeyondNations.Core.csproj" />
  </ItemGroup>

</Project>
