<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renderer parity (#275): draws the same snapshot with SilkWorldRenderer and
    NativeWorldRenderer in one process and one GL context, and fails when
    their draw counts differ or their images differ beyond tolerance. Run by
    the "Renderer parity" CI job under Xvfb and llvmpipe.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RootNamespace>beyondnations.tools.parity</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BeyondNations.Desktop/BeyondNations.Desktop.csproj" />
  </ItemGroup>

</Project>
